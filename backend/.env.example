APP_TITLE=Smart Whiteboard Backend
APP_DESCRIPTION=Backend API for the Smart Whiteboard application.
APP_VERSION=1.0.0
AI_PROVIDER=mock
RECOGNITION_TIMEOUT_SECONDS=30
MAX_CONCURRENT_RECOGNITION_REQUESTS=10
# JSON array of allowed frontend origins; add local development origins as needed.
# Do not use ["*"] while ALLOW_CREDENTIALS=true.
ALLOWED_ORIGINS=["http://localhost:5173"]
ALLOW_CREDENTIALS=true
# Maximum JSON request body for recognition endpoints (1 KiB to 16 MiB).
MAX_REQUEST_BODY_BYTES=1048576
